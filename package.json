{
  "name": "yonder-pdf",
  "productName": "Yonder PDF",
  "version": "0.1.0",
  "description": "Yonder PDF - view, annotate, sign, fill and organize PDFs. Free, ad-supported.",
  "main": "./out/main/index.js",
  "author": "Yonder Tech",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "e2e": "node scripts/e2e/cdp.mjs scripts/e2e/annotate.mjs && node scripts/e2e/cdp.mjs scripts/e2e/pages.mjs && node scripts/e2e/cdp.mjs scripts/e2e/reopen.mjs e2e-out/saved.pdf",
    "fixture": "node scripts/make-fixture.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings scripts/unit/pageops.test.mts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.42.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yondertech-admin/yonder-pdf.git"
  },
  "homepage": "https://github.com/yondertech-admin/yonder-pdf"
}
