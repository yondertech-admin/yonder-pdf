{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["src/core/*"], "@node/*": ["src/node/*"], "@shared/*": ["src/shared/*"] }
  },
  "include": ["src/core/**/*", "src/node/**/*", "src/cli/**/*", "src/mcp/**/*", "src/shared/**/*"]
}
